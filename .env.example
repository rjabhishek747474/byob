# ─────────────────────────────────────────────────────────────────────
# BeYourOwnBoss – Environment Variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────

# Application environment: development | test | production
NODE_ENV=development

# Port the Next.js server listens on
PORT=3000

# Public-facing base URL (used for OAuth callbacks, emails, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────

# Primary PostgreSQL connection string (Drizzle ORM)
DATABASE_URL=postgres://byob_dev:devpassword123@localhost:5432/byob_development

# Separate connection string used by the test runner (points to db-test)
DATABASE_URL_TEST=postgres://byob_dev:devpassword123@localhost:5433/byob_test

# ── Authentication ───────────────────────────────────────────────────

# Random secret used to sign JWTs / session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-random-secret

# Auth provider to use: "local" for email/password, "cognito" for AWS Cognito
AUTH_PROVIDER=local

# ── AWS Cognito (only required when AUTH_PROVIDER=cognito) ───────────

# AWS region where the Cognito User Pool lives
AWS_REGION=us-east-1

# Cognito User Pool identifier
COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito App Client ID (public client, no secret)
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ── File Storage ─────────────────────────────────────────────────────

# Storage backend: "local" for disk, "s3" for AWS S3
STORAGE_PROVIDER=local

# S3 bucket name (only required when STORAGE_PROVIDER=s3)
S3_BUCKET=byob-uploads-dev

# S3 bucket region (only required when STORAGE_PROVIDER=s3)
S3_REGION=us-east-1

# Absolute path for local file uploads (only required when STORAGE_PROVIDER=local)
LOCAL_STORAGE_PATH=./uploads

# ── Observability ────────────────────────────────────────────────────

# Minimum log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ── Multi-tenancy ───────────────────────────────────────────────────

# Root domain used for tenant subdomain routing (e.g. "beyourownboss.local")
PLATFORM_DOMAIN=localhost
